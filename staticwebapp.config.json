{
  "routes": [
    {
      "route": "/admin",
      "rewrite": "/admin.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/admin*", "/js/*", "/styles.css", "/config.js", "/*.jpeg", "/*.jpg", "/*.png", "/*.svg", "/*.ico", "/staticwebapp.config.json", "/favicon.png", "/favicon.svg"]
  },
  "mimeTypes": {
    ".js": "text/javascript",
    ".css": "text/css",
    ".html": "text/html",
    ".jpeg": "image/jpeg",
    ".jpg": "image/jpeg",
    ".png": "image/png",
    ".svg": "image/svg+xml",
    ".ico": "image/x-icon"
  }
}
